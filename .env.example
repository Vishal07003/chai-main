# Django Core
DJANGO_SECRET_KEY=your-secure-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# JWT Authentication
JWT_SIGNING_KEY=your-jwt-signing-key-here
JWT_ACCESS_TOKEN_LIFETIME_DAYS=7
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# OTP Provider API Configuration (e.g. 2Factor.in)
TWOFACTOR_API_KEY=your-twofactor-api-key-here
OTP_PROVIDER_BASE_URL=https://2factor.in/API/V1
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MOCK_MODE=False

# CORS Configuration (for production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081

# Firebase Cloud Messaging Service Account (Keep private, never commit service-account.json)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
